---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Khalil Cader — Product Designer', description = 'Khalil Cader is a product designer at Anthropic, designing tools that shape how people think, collaborate, and create.' } = Astro.props;
const base = import.meta.env.BASE_URL;
// Absolute, for link previews (set SITE to the live domain when deploying).
const ogImage = new URL(`${base}og.png`, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <!-- Link previews (iMessage, Slack, LinkedIn, X). -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Who this is, for search engines. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Person', name: 'Khalil Cader', jobTitle: 'Product Designer',
      worksFor: { '@type': 'Organization', name: 'Anthropic' }, url: new URL(base, Astro.site).href,
      image: new URL(`${base}images/khalil.jpg`, Astro.site).href, address: { '@type': 'PostalAddress', addressLocality: 'New York' },
    })} />
    <!-- Before first paint: mark JS as available, and apply a pinned theme so it never flashes. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // Phones get their own simple layout (a vertical list; see
      // scripts/work-strip.ts). Crossing the breakpoint reloads into the other.
      const phone = matchMedia('(max-width: 639px)');
      if (phone.matches) document.documentElement.classList.add('mobile');
      // Every iOS browser draws with Safari's engine (html.ios; iPads report as Macs with touch).
      if (/iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) document.documentElement.classList.add('ios');
      phone.addEventListener('change', () => location.reload());
      try {
        // No theme switcher on phones: they follow the system.
        const t = phone.matches ? null : localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.scheme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/smooth-corners';
    </script>
  </body>
</html>
