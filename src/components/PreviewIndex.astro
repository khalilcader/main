---
/*
  Scrollable project list on the left, a soft shader "stage" on the right
  (Figma frames 43:2, 49:108). Hovering a row pops a small thumbnail card
  out next to the cursor, which it then trails; leaving shrinks it away. Clicking
  a row selects it and the stage slowly crossfades to its colours. Clicking the
  selected row again opens its case study. On narrow screens the stage sits on
  top and the row nearest it as you scroll is selected.
*/
import DeviceFrame from './DeviceFrame.astro';

export interface PreviewItem {
  title: string;
  vibe: string;      // names a --vibe-<key>-1..3 colour set in tokens.css
  href?: string;     // case study link, when one exists
  media?: string;    // image or video shown on the device screen
  mediaAlt?: string;
  thumb?: string;    // image for the hover card; falls back to the vibe's colours
}

interface Props {
  items: PreviewItem[];
  ripple?: number;   // px the stage edge ripples in and out; 0 for a still edge
  rowHighlight?: boolean;  // grey pill behind the hovered row (Figma 49:114)
}
const { items, ripple = 10, rowHighlight = true } = Astro.props;
---
<div class="preview-index" data-preview-index data-ripple={ripple} data-row-highlight={rowHighlight ? '' : undefined}
  style={`--stage-ripple: ${ripple}px`}>
  <div class="list-wrap">
    <ol class="list">
      {items.map((item, i) => {
        const num = String(i + 1).padStart(2, '0');
        const inner = (
          <>
            <span class="row__num">
              <span class="row__digits">{num}</span>
              {/* "now playing" bars, shown on the selected row instead of its number */}
              <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
            </span>
            <span class="row__title">{item.title}</span>
          </>
        );
        return (
          <li class="row" data-row data-vibe={item.vibe} data-active={i === 0 ? '' : undefined}
            style={`--accent: var(--vibe-${item.vibe}-1)`}>
            {item.href
              ? <a class="row__hit" href={item.href} aria-current={i === 0 ? 'true' : undefined}>{inner}</a>
              : <button class="row__hit" type="button" aria-pressed={i === 0 ? 'true' : 'false'}>{inner}</button>}
            <div class="peek" aria-hidden="true">
              <div class="peek__shadow"></div>
              <div class="peek__body" data-peek-body
                style={`--v1: var(--vibe-${item.vibe}-1)`}>
                {item.thumb && <img src={item.thumb} alt="" />}
                <svg class="peek__rim"><path /></svg>
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </div>

  <div class="fade" aria-hidden="true"></div>

  <div class="stage" aria-hidden="true">
    <div class="stage__fallback" data-stage-fallback></div>
    <canvas class="stage__canvas" data-stage-canvas></canvas>
    {items.map((item, i) => (
      <div class="stage__slide" data-slide data-active={i === 0 ? '' : undefined}>
        <DeviceFrame src={item.media} alt={item.mediaAlt} />
      </div>
    ))}
  </div>

</div>

<script>
  import { createStage } from '../scripts/stage-shader';
  import { clipSquircle } from '../scripts/squircle';

  for (const root of document.querySelectorAll<HTMLElement>('[data-preview-index]')) {
    const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];
    const hits = rows.map((r) => r.querySelector<HTMLElement>('.row__hit')!);
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const canvas = root.querySelector<HTMLCanvasElement>('[data-stage-canvas]')!;
    const fallback = root.querySelector<HTMLElement>('[data-stage-fallback]')!;
    const stageEl = root.querySelector<HTMLElement>('.stage')!;
    const css = getComputedStyle(root);
    const stacked = matchMedia('(max-width: 900px)');

    // ── stage
    let stage: ReturnType<typeof createStage> = null;
    try {
      stage = createStage(canvas, {
        feather: parseFloat(css.getPropertyValue('--stage-feather')) || 36,
        radius: parseFloat(css.getPropertyValue('--radius-stage')) || 48,
        ripple: Number(root.dataset.ripple) || 0,
      });
    } catch (err) {
      console.warn('Stage shader unavailable, using CSS fallback', err);
    }
    if (!stage) root.classList.add('no-webgl');

    // ── selection: what the stage shows
    let active = 0;
    const select = (i: number) => {
      if (i === active || i < 0) return;
      active = i;
      rows.forEach((r, j) => r.toggleAttribute('data-active', j === i));
      hits.forEach((h, j) => {
        if (h.tagName === 'A') h.toggleAttribute('aria-current', j === i);
        else h.setAttribute('aria-pressed', String(j === i));
      });
      slides.forEach((s, j) => s.toggleAttribute('data-active', j === i));
      const vibe = rows[i].dataset.vibe ?? 'sky';
      stage?.setVibe(vibe);
      fallback.style.setProperty('--stage-color', `var(--vibe-${vibe}-1)`);
    };
    const firstVibe = rows[0]?.dataset.vibe ?? 'sky';
    stage?.setVibe(firstVibe);
    fallback.style.setProperty('--stage-color', `var(--vibe-${firstVibe}-1)`);

    // First click selects; clicking the selected row follows its link.
    hits.forEach((hit, i) => {
      hit.addEventListener('click', (e) => {
        if (i !== active) { e.preventDefault(); select(i); }
      });
    });

    // ── hover: each row's card scales up as you enter and down as you leave
    const cardRadius = parseFloat(css.getPropertyValue('--radius-card')) || 12;
    const smoothing = parseFloat(css.getPropertyValue('--corner-smoothing')) || 0.6;
    for (const body of root.querySelectorAll<HTMLElement>('[data-peek-body]')) {
      const rim = body.querySelector('path')!;
      clipSquircle(body, () => cardRadius, smoothing, (d, w, h) => {
        rim.ownerSVGElement!.setAttribute('viewBox', `0 0 ${w} ${h}`);
        rim.setAttribute('d', d);
      });
    }
    // Where the card goes:
    // - It rests --peek-gap right of the label, centred on the row, when the
    //   cursor is at the row's left edge / vertical centre.
    // - From there it moves only a fraction (--peek-pull) of the cursor's
    //   movement on both axes, and eases after it: tethered, not glued.
    // - It stays right of the cursor: once the cursor gets within --peek-lead
    //   of its left edge, the cursor pushes it along.
    // - While easing it may lag, but never so far that it slides under the
    //   cursor (--peek-clear).
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const gap = parseFloat(css.getPropertyValue('--peek-gap')) || 40;
    const pull = parseFloat(css.getPropertyValue('--peek-pull')) || 0.35;
    const ease = parseFloat(css.getPropertyValue('--peek-follow')) || 0.22;
    const lead = parseFloat(css.getPropertyValue('--peek-lead')) || 24;
    const clear = parseFloat(css.getPropertyValue('--peek-clear')) || 12;

    rows.forEach((row, i) => {
      const card = row.querySelector<HTMLElement>('.peek')!;
      const label = row.querySelector<HTMLElement>('.row__title')!;
      let x = 0, y = 0, tx = 0, ty = 0, floorX = 0, raf = 0;

      const aim = (clientX: number, clientY: number) => {
        const r = row.getBoundingClientRect();
        const restX = label.getBoundingClientRect().right - r.left + gap;
        const restY = r.height / 2;
        const cx = Math.max(0, clientX - r.left), cy = clientY - r.top;
        tx = Math.max(restX + cx * pull, cx + lead);
        floorX = cx + clear;
        ty = restY + (cy - restY) * pull - card.offsetHeight / 2;
      };
      const apply = () => { card.style.translate = `${x}px ${y}px`; };
      const tick = () => {
        x = Math.max(x + (tx - x) * ease, floorX);
        y += (ty - y) * ease;
        apply();
        raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(tick) : 0;
      };
      const chase = () => {
        if (reduced.matches) { x = tx; y = ty; apply(); return; }
        if (!raf) raf = requestAnimationFrame(tick);
      };
      // Appear right where it should be, then follow from there.
      const on = (clientX: number, clientY: number) => {
        aim(clientX, clientY);
        x = tx; y = ty; apply();
        row.setAttribute('data-hover', '');
      };
      const off = () => row.removeAttribute('data-hover');

      row.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') on(e.clientX, e.clientY); });
      row.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse' || !row.hasAttribute('data-hover')) return;
        aim(e.clientX, e.clientY);
        chase();
      });
      row.addEventListener('pointerleave', off);
      // Keyboard: park it just right of the label, centred on the row.
      row.addEventListener('focusin', () => {
        if (!hits[i].matches(':focus-visible')) return;
        const r = row.getBoundingClientRect();
        on(label.getBoundingClientRect().right + gap, r.top + r.height / 2);
      });
      row.addEventListener('focusout', off);
    });

    // ── narrow screens: the stage is stacked on top, so follow the scroll
    let ticking = false;
    const follow = () => {
      ticking = false;
      if (!stacked.matches) return;
      const stageBottom = stageEl.getBoundingClientRect().bottom;
      const line = stageBottom + (innerHeight - stageBottom) * 0.3;
      let best = 0, bestDist = Infinity;
      rows.forEach((r, i) => {
        const b = r.getBoundingClientRect();
        const d = Math.abs((b.top + b.bottom) / 2 - line);
        if (d < bestDist) { bestDist = d; best = i; }
      });
      select(best);
    };
    addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(follow); }
    }, { passive: true });
  }
</script>

<style>
  /* ── list */
  .list-wrap {
    position: relative;
    /* never runs under the stage, which starts at 50% */
    width: min(var(--list-width), calc(50vw - var(--space-7) - var(--space-5)));
  }
  .list {
    margin: 0;
    padding: 0 0 var(--fade-height);
    list-style: none;
  }
  .row__hit {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    min-height: var(--row-height);
    padding: var(--space-3);
    border: 0;
    border-radius: var(--radius-row);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--text-lg);
    line-height: normal;
    letter-spacing: var(--tracking);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .row { position: relative; }
  [data-row-highlight] .row[data-hover] .row__hit { background: var(--color-row-hover); }
  .row__hit:focus-visible { outline: 1px solid var(--color-fg); outline-offset: -1px; }
  /* Rest at 20%; the selected and hovered rows come up to full strength. */
  .row__num,
  .row__title {
    opacity: 0.2;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .row[data-active] :is(.row__num, .row__title),
  .row[data-hover] :is(.row__num, .row__title) { opacity: 1; }
  .row__num {
    position: relative;
    flex: none;
    min-width: var(--index-width);
    color: var(--color-muted);
  }
  .row__digits { transition: opacity var(--duration-fast) var(--ease-out); }
  .row[data-active] .row__digits { opacity: 0; }

  /* ── selected row: three small bars bouncing in the project's stage colour */
  .eq {
    position: absolute;
    left: 0;
    top: 50%;
    display: flex;
    align-items: center;
    gap: var(--eq-gap);
    height: var(--eq-height);
    margin-top: calc(var(--eq-height) / -2);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .row[data-active] .eq { opacity: 1; }
  .eq i {
    width: var(--eq-bar);
    height: 60%;
    border-radius: var(--eq-bar);
    background: var(--accent);
    /* height, not scale: scaling would squash the round ends flat */
    animation: eq var(--eq-speed) ease-in-out infinite alternate paused;
  }
  .row[data-active] .eq i { animation-play-state: running; }
  /* Different lengths and offsets so the three never fall into step. */
  .eq i:nth-child(1) { animation-duration: calc(var(--eq-speed) * 1.0); animation-delay: -0.2s; }
  .eq i:nth-child(2) { animation-duration: calc(var(--eq-speed) * 0.8); animation-delay: -0.5s; }
  .eq i:nth-child(3) { animation-duration: calc(var(--eq-speed) * 1.15); animation-delay: -0.1s; }
  /* A gentle breath, not a meter: bars stay between half and ~¾ height. */
  @keyframes eq {
    from { height: 50%; }
    50%  { height: 72%; }
    to   { height: 60%; }
  }
  .row__title { color: var(--color-fg); }

  /* ── hover card (Figma 49:179). Positioned by script: it trails the cursor
     but stays clear of the label. Pops in on enter, shrinks away on leave. */
  .peek {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--card-width);
    height: var(--card-height);
    z-index: 1;
    pointer-events: none;
    scale: 0.6;
    opacity: 0;
    transform-origin: 0% 50%;  /* grows out toward the stage */
    /* out: quick, so it's gone before the next card lands */
    transition:
      scale var(--duration-instant) var(--ease-in),
      opacity var(--duration-instant) var(--ease-in);
  }
  /* The selected project is already on the stage, so its row shows no card;
     clicking a row makes its card shrink away. */
  .row[data-hover]:not([data-active]) .peek {
    scale: 1;
    opacity: 1;
    /* in: visible almost at once, then the scale pops past 1 and settles */
    transition:
      scale var(--duration-pop) var(--ease-pop),
      opacity var(--duration-instant) linear;
  }
  .peek__shadow,
  .peek__body {
    position: absolute;
    inset: 0;
    border-radius: calc(var(--radius-card) * 1px);
  }
  .peek__shadow { box-shadow: var(--shadow-card); }  /* outside the clip */
  .peek__body {
    overflow: hidden;
    /* placeholder until a project has a thumbnail: its stage base colour */
    background: var(--v1, var(--color-card));
  }
  .peek__body img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .peek__rim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .peek__rim path {
    fill: none;
    stroke: var(--color-card-border);
    stroke-width: 2px;  /* half is clipped: a 1px inside border */
  }

  /* ── stage */
  .stage {
    position: fixed;
    inset: var(--stage-inset) var(--stage-inset) var(--stage-inset) 50%;
  }
  /* The canvas spills past the stage by the feather plus the ripple, so the
     blur lands on the stage's edge the way Figma's layer blur does and the
     edge ripples around Figma's rectangle rather than inside it. */
  .stage__canvas,
  .stage__fallback {
    --spill: calc(var(--stage-feather) + var(--stage-ripple, 0px));
    position: absolute;
    inset: calc(-1 * var(--spill));
    width: calc(100% + 2 * var(--spill));
    height: calc(100% + 2 * var(--spill));
  }
  .stage__fallback {
    display: none;
    inset: 0;
    width: 100%;
    height: 100%;
    background: var(--stage-color, var(--apple-blue));
    border-radius: var(--radius-stage);
    filter: blur(calc(var(--stage-feather) / 2));
    transition: background-color var(--duration-slow) var(--ease-out);
  }
  .no-webgl .stage__fallback { display: block; }
  .no-webgl .stage__canvas { display: none; }

  .stage__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6) var(--space-4);
    opacity: 0;
    transform: scale(0.98);
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
  }
  .stage__slide[data-active] {
    opacity: 1;
    transform: none;
  }

  /* ── soft blur + fade over the end of the list (Figma: Rectangle 10) */
  .fade {
    position: fixed;
    left: 0;
    bottom: 0;
    width: 50%;
    height: var(--fade-height);
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--color-bg) 85%);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    mask-image: linear-gradient(to bottom, transparent, #000 60%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 60%);
    opacity: 0.8;
  }

  /* ── narrow: stage on top, list scrolls under it */
  @media (max-width: 900px) {
    .preview-index { display: flex; flex-direction: column; }
    .list-wrap { width: 100%; }
    .peek { display: none; }
    .stage {
      order: -1;
      position: sticky;
      inset: 0 auto auto;
      z-index: 1;
      height: 58svh;
      margin: 0 calc(-1 * var(--gutter)) var(--space-3);
      background: var(--color-bg);
    }
    .stage__canvas { inset: var(--gutter); width: calc(100% - 2 * var(--gutter)); height: calc(100% - 2 * var(--gutter)); }
    .stage__slide { padding: calc(var(--gutter) + var(--space-5)) var(--space-4); }
    .list { padding-bottom: 50svh; }
    .row__hit { padding-inline: 0; border-radius: 0; }
    .fade { width: 100%; height: calc(var(--fade-height) / 2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .eq i { animation: none; }
    .eq i:nth-child(1) { height: 50%; }
    .eq i:nth-child(2) { height: 72%; }
    .eq i:nth-child(3) { height: 60%; }
    .stage__slide { transform: none; transition-duration: 1ms; }
    .peek, .row[data-hover]:not([data-active]) .peek { scale: 1; transition: opacity var(--duration-fast) linear; }
  }
</style>
