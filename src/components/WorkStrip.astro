---
import Cover from './Cover.astro';
import { getCollection } from 'astro:content';
import stills from '../data/blur-stills.json';

// The work strip (Figma 53:324): a row of covers you can drag, pull up into a
// large focus strip, or switch to a grid. The motion lives in
// src/scripts/work-strip.ts; without JavaScript the covers sit in a plain
// scrolling row.
const work = (await getCollection('work', (w) => !w.data.hidden)).sort((a, b) => a.data.order - b.data.order);
// Grid lightbox: each cover's blurred still (made by the project-video
// skill's blur-stills scripts), placed as a share of the card's box.
const still = (id: string) => (stills as Record<string, { l: number; t: number; w: number; h: number }>)[id];
const base = import.meta.env.BASE_URL;
---
<div class="stage" id="stage" aria-label="Selected work">
  <!-- Grid lightbox: the other covers' blurred stills (work-strip.ts fills it). -->
  <div class="stills" id="stills" data-base={`${base}images/work/blur/`} aria-hidden="true"></div>
  <div class="backdrop" id="backdrop"></div>
  <!-- Grain on its own layer above the blur, so its blend reaches the page. -->
  <div class="backdrop-grain" id="backdrop-grain"></div>
  {work.map((item, i) => (
    <button
      class="card"
      type="button"
      data-cursor-grow
      data-i={i}
      data-slug={item.id}
      data-wide={item.data.cover.aspect > 1 ? '' : undefined}
      data-still={still(item.id) ? [still(item.id).l, still(item.id).t, still(item.id).w, still(item.id).h].join(',') : undefined}
      data-aspect={item.data.cover.aspect}
      aria-label={`${item.data.title}. ${item.data.cover.alt}`}
      style={`--aspect: ${item.data.cover.aspect}`}
    >
      <!-- Shadows: plain layers behind the cover (a drop-shadow filter on the
           card was recomputed from its live content every frame). The hover
           one cross-fades in. -->
      <span class="shadow rest" aria-hidden="true"></span>
      <span class="shadow lift" aria-hidden="true"></span>
      <Cover cover={item.data.cover} />
      <span class="label" aria-hidden="true" data-smooth="surface"><span class="label-text">{item.data.title}<span class="label-year">{item.data.year}</span></span></span>
      <div class="veil"></div>
    </button>
  ))}
</div>

<!-- Grid view: protects the header once the covers scroll under it. Outside
     the stage: inside it, Chrome stopped blurring what's behind it. It fades
     out as a cover opens (work-strip.ts sets --lb). -->
<div class="top-scrim" aria-hidden="true"></div>
<div class="edge l" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
<div class="edge r" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>

<script>
  import '../scripts/work-strip';
</script>

<style>
  /* No JavaScript: a plain horizontal row under the header. */
  .stage {
    position: fixed; inset: 0; overflow-x: auto; overflow-y: hidden;
    display: flex; gap: var(--row-gap); align-items: flex-start;
    padding: calc(var(--header-top) + var(--header-pad) * 2 + var(--photo-height) + var(--row-gap-below-header)) var(--page-pad) 0;
  }
  .card {
    position: relative; flex: none;
    height: min(var(--row-height), 60vh); aspect-ratio: var(--aspect);
    padding: 0; margin: 0; border: 0; background: none; color: inherit;
    border-radius: var(--cover-radius);
    font: inherit; text-align: left; cursor: pointer;
  }
  .card :global(.cover) { border: var(--cover-border-width) solid var(--color-cover-border); }

  /* With JavaScript: one full-bleed stage; covers are placed with transforms. */
  :global(.js) .stage {
    display: block; overflow: hidden; padding: 0;
    touch-action: none; user-select: none; -webkit-user-select: none;
    cursor: grab;
  }
  :global(.js) .stage.dragging { cursor: grabbing; }
  :global(.js) .card {
    position: absolute; left: 0; top: 0; height: auto; aspect-ratio: auto;
    transform-origin: 0 0; will-change: transform;
    cursor: inherit;
  }
  :global(.js) .card :global(.cover) { border: 0; }
  /* Phones (html.mobile, see Base.astro): a plain vertical list, each cover
     full width at rest with its title and year under it. No shadows, no
     autoplay; a tap plays it in the system's player (work-strip.ts). */
  :global(html.mobile) .stage {
    position: static; display: flex; flex-direction: column; gap: var(--mobile-card-gap);
    overflow: visible; touch-action: auto; cursor: auto; user-select: auto; -webkit-user-select: auto;
    padding: calc(env(safe-area-inset-top, 0px) + var(--header-top) + var(--header-pad) * 2 + var(--photo-height) + var(--row-gap-below-header)) var(--page-pad) var(--mobile-bottom-pad);
  }
  :global(html.mobile) .card {
    container-type: inline-size;
    position: relative; width: 100%; height: auto; aspect-ratio: auto;
    transform: none !important; opacity: 1 !important; filter: none !important; visibility: visible !important;
    will-change: auto; cursor: pointer;
  }
  /* Two staggered columns, like the desktop grid: every cover half width,
     each placed in whichever column is shorter (work-strip.ts). */
  :global(html.mobile) .stage { flex-direction: row; align-items: flex-start; gap: var(--mobile-col-gap); }
  :global(html.mobile) .stage > :global(.col) { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: var(--mobile-card-gap); }
  /* Tapped: the cover lifts out of the list to fill the screen and plays
     (work-strip.ts), over the page faded out; a placeholder keeps its spot. */
  :global(html.mobile) .card :global(.cover.viewing) { position: fixed; z-index: 71; aspect-ratio: auto; }
  :global(.viewer-scrim) { position: fixed; inset: 0; z-index: 70; background: var(--color-bg); touch-action: none; }
  :global(.viewer-scrim[hidden]) { display: none; }
  :global(.viewer-close) {
    position: absolute; left: var(--page-pad); top: calc(env(safe-area-inset-top, 0px) + var(--page-pad));
    width: var(--button-size); height: var(--button-size); padding: 0; display: grid; place-items: center;
    border: var(--button-border-width) solid var(--color-button-border); border-radius: var(--button-radius);
    background: var(--color-button-bg); color: var(--color-fg); box-shadow: var(--button-shadow);
  }
  :global(.viewer-close svg) { width: var(--icon-size); height: var(--icon-size); }
  :global(html.mobile) .card :global(.cover) {
    position: relative; inset: auto; width: 100%; aspect-ratio: var(--aspect);
    border: 0; border-radius: calc(var(--cover-radius-share) * 100cqw / var(--aspect));   /* until the script's smoothed clip (and outline) take over */
  }
  :global(html.mobile) .card :global(.outline) { stroke-width: var(--cover-border-width); }
  :global(html.mobile) .shadow, :global(html.mobile) .veil,
  :global(html.mobile) .stills, :global(html.mobile) .backdrop, :global(html.mobile) .backdrop-grain,
  :global(html.mobile) .edge { display: none; }
  :global(html.mobile) .label {
    position: static; display: block; transform: none; opacity: 1;
    margin-top: var(--label-below-gap); padding: 0; border: 0; background: none;
    -webkit-backdrop-filter: none; backdrop-filter: none;
    font-size: var(--label-below-size); text-align: center; white-space: normal;
    --show: 1;
  }
  :global(html.mobile) .label > :global(.smooth-layer),
  :global(html.mobile) .label > :global(.smooth-border),
  :global(html.mobile) .label::before { display: none; }
  /* No focus ring: a focused cover lifts and shows its title, like hover (script). */
  .card:focus-visible { outline: none; }

  .shadow {
    position: absolute; inset: 0;
    /* Rounder than the cover, so the shadow's box stays inside the smoothed
       outline and no unshadowed sliver shows at the corners. */
    border-radius: calc(var(--shadow-r, var(--cover-radius)) * (1 + var(--cover-smoothing)));
    pointer-events: none;
  }
  .shadow.rest { box-shadow: 0 var(--shadow-y0) var(--shadow-b0) 0 var(--color-cover-shadow); }
  .shadow.lift { box-shadow: 0 var(--shadow-y1) var(--shadow-b1) 0 var(--color-cover-shadow-hover); opacity: 0; }
  :global(html:not(.js)) .shadow { display: none; }

  /* Title pill, shown on hover and keyboard focus. Script sets --pop (a
     springy 0..1 that overshoots a little), --show (clamped, for opacity) and
     --unscale (keeps it the same size on screen however the cover is scaled).
     Same glass as the header buttons. */
  .label {
    position: absolute; left: 50%; bottom: calc(var(--label-offset) * var(--unscale, 1));
    transform: translateX(-50%) translateY(calc((1 - var(--pop, 0)) * var(--label-rise)))
      scale(calc(var(--unscale, 1) * (1 - (1 - var(--pop, 0)) * var(--label-grow))));
    transform-origin: 50% 100%;
    padding: var(--label-pad-y) var(--label-pad-x);
    --surface-bg: var(--color-label-bg);
    --surface-border: var(--color-button-border);
    --surface-border-top: 0.35;   /* lit from above: darker underneath */
    --surface-blur: blur(var(--button-blur)) saturate(var(--glass-saturate));
    border: var(--button-border-width) solid var(--surface-border);
    border-radius: var(--label-radius);
    background: var(--surface-bg);
    -webkit-backdrop-filter: var(--surface-blur); backdrop-filter: var(--surface-blur);
    color: var(--color-fg);
    font-family: inherit; font-size: var(--text-name-size); font-weight: var(--text-name-weight);
    letter-spacing: var(--text-name-tracking); line-height: 1.25;
    white-space: nowrap; pointer-events: none;
  }
  /* Fades in by its parts (glass, text, shadow), never the label as a whole:
     opacity below 1 on the label would cut its glass off from the page behind,
     so the blur would drop out mid-fade and snap back on as it settled. */
  .label > :global(.smooth-layer), .label > :global(.smooth-border), .label-text, .label::before { opacity: var(--show, 0); }
  .label::before {
    content: ""; position: absolute; inset: calc(-1 * var(--button-border-width)); z-index: -2;
    border-radius: inherit; box-shadow: var(--label-shadow);
  }
  .label:not(:global(.smooth-host)) { opacity: 0; }
  /* The pill animates (it pops and scales on hover); a clip-path on a
     backdrop-filtered layer that's animating flickered between rounded and
     square in Chrome, so its glass is rounded by border-radius alone. */
  .label > :global(.smooth-layer) { clip-path: none !important; }   /* until its glass layer is set up */
  /* In the row, the title is plain text under the cover, no glass; the pill
     stays for the grid, where there's no room beneath. */
  :global(html:not([data-grid])) .label {
    bottom: auto; top: calc(100% + var(--label-below-gap) * var(--unscale, 1));
    transform: translateX(-50%) translateY(calc((1 - var(--pop, 0)) * var(--label-rise)))
      scale(var(--unscale, 1));
    transform-origin: 50% 0;
    padding: 0;
    font-size: var(--label-below-size); text-align: center;
  }
  /* The year: on its own line under the title, smaller and lighter; row view only. */
  .label-year { display: none; }
  :global(html:not([data-grid])) .label-year {
    display: block; margin-top: var(--label-year-gap);
    color: var(--color-label-year); font-size: var(--label-year-size); font-weight: 400; letter-spacing: 0;
  }
  :global(html:not([data-grid])) .label > :global(.smooth-layer),
  :global(html:not([data-grid])) .label > :global(.smooth-border),
  :global(html:not([data-grid])) .label::before { display: none; }
  :global(html:not(.js)) .label { display: none; }

  /* Grain over anything pushed out of focus. The cover itself fades and blurs;
     this layer reaches past it by the blur's spill (--f) and feathers over it,
     so it never shows a hard edge. */
  .veil {
    position: absolute; inset: calc(var(--f, 0px) * -1); border-radius: inherit;
    background: var(--veil-tint);   /* dark mode: leaving covers darken under their grain */
    pointer-events: none; opacity: 0;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 calc(var(--f, 0px) * 2.5), #000 calc(100% - var(--f, 0px) * 2.5), transparent),
                        linear-gradient(to bottom, transparent, #000 calc(var(--f, 0px) * 2.5), #000 calc(100% - var(--f, 0px) * 2.5), transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 calc(var(--f, 0px) * 2.5), #000 calc(100% - var(--f, 0px) * 2.5), transparent),
                linear-gradient(to bottom, transparent, #000 calc(var(--f, 0px) * 2.5), #000 calc(100% - var(--f, 0px) * 2.5), transparent);
    mask-composite: intersect;
  }
  .veil::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit;
    background-image: var(--grain); background-size: var(--grain-size) var(--grain-size);
    mix-blend-mode: var(--grain-blend); opacity: min(1, calc(var(--grain-amount) * var(--grain-strength)));
  }

  /* Grid lightbox: each other cover cross-fades to a still of itself, blurred
     ahead of time (a live blur either missed parts of some covers or, on the
     covers themselves, made Chrome redraw them blank as it came off). Over
     the covers, under the tint and the open cover. */
  .stills { position: absolute; inset: 0; z-index: 15; pointer-events: none; opacity: 0; }
  .stills :global(img) { position: absolute; left: 0; top: 0; max-width: none; }
  .stills :global(.night) { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-scheme="light"])) .stills :global(.day) { display: none; }
    :global(html:not([data-scheme="light"])) .stills :global(.night) { display: block; }
  }
  :global(html[data-scheme="dark"]) .stills :global(.day) { display: none; }
  :global(html[data-scheme="dark"]) .stills :global(.night) { display: block; }
  .stills :global(img.out) { visibility: hidden; }   /* the open cover's own */
  /* Grid lightbox: everything else fades to the page. */
  .backdrop {
    position: absolute; inset: 0; z-index: 16; pointer-events: none;
    background: var(--color-scrim);
    opacity: 0;
  }
  /* Same grain as the About overlay: overlay in light mode; in dark, plain
     near-black speckles (a blend would lift the page, or trace the blurred
     cards' edges). Faded with the backdrop. */
  .backdrop-grain {
    position: absolute; inset: 0; z-index: 16; pointer-events: none;
    background-image: var(--grain); background-size: var(--grain-size) var(--grain-size);
    mix-blend-mode: var(--scrim-grain-blend); filter: var(--scrim-grain-filter);
    opacity: 0;
  }

  /* Progressive edge blur: eight stacked backdrop blurs, strength rising along
     an eased curve (set in script), each masked to its own overlapping band, plus
     a fade to the page on top. No blend-mode grain in or over the edge: inside it
     isolates the backdrop blur, over it brightens mid-tones into a streak. */
  .edge {
    display: none;
    position: fixed; top: 0; bottom: 0; z-index: 25; pointer-events: none;
    width: var(--edge-w, 8vw); will-change: transform;
  }
  :global(.js) .edge { display: block; }
  .edge.l { left: 0; }
  .edge.r { right: 0; transform: scaleX(-1); }
  /* Each band covers only its own strip of the edge (where its mask is
     non-zero), so no band blurs pixels it then masks away. */
  .edge i { position: absolute; top: 0; bottom: 0; display: block; -webkit-backdrop-filter: blur(var(--b)); backdrop-filter: blur(var(--b)); }
  .edge i.off { display: none; }   /* too faint to see: skip its blur pass */
  .edge::after { content: ""; position: absolute; inset: 0; background: var(--fade, none); }
  .edge i:nth-child(1) { right: 0%; width: 37.5%; -webkit-mask-image: linear-gradient(to left, transparent 0%, #000 33.33%, #000 66.67%, transparent 100%); mask-image: linear-gradient(to left, transparent 0%, #000 33.33%, #000 66.67%, transparent 100%); }
  .edge i:nth-child(2) { right: 12.5%; width: 37.5%; -webkit-mask-image: linear-gradient(to left, transparent 0%, #000 33.33%, #000 66.67%, transparent 100%); mask-image: linear-gradient(to left, transparent 0%, #000 33.33%, #000 66.67%, transparent 100%); }
  .edge i:nth-child(3) { right: 25%; width: 37.5%; -webkit-mask-image: linear-gradient(to left, transparent 0%, #000 33.33%, #000 66.67%, transparent 100%); mask-image: linear-gradient(to left, transparent 0%, #000 33.33%, #000 66.67%, transparent 100%); }
  .edge i:nth-child(4) { right: 37.5%; width: 37.5%; -webkit-mask-image: linear-gradient(to left, transparent 0%, #000 33.33%, #000 66.67%, transparent 100%); mask-image: linear-gradient(to left, transparent 0%, #000 33.33%, #000 66.67%, transparent 100%); }
  .edge i:nth-child(5) { right: 50%; width: 37.5%; -webkit-mask-image: linear-gradient(to left, transparent 0%, #000 33.33%, #000 66.67%, transparent 100%); mask-image: linear-gradient(to left, transparent 0%, #000 33.33%, #000 66.67%, transparent 100%); }
  .edge i:nth-child(6) { right: 62.5%; width: 37.5%; -webkit-mask-image: linear-gradient(to left, transparent 0%, #000 33.33%, #000 66.67%, transparent 100%); mask-image: linear-gradient(to left, transparent 0%, #000 33.33%, #000 66.67%, transparent 100%); }
  .edge i:nth-child(7) { right: 75%; width: 25%; -webkit-mask-image: linear-gradient(to left, transparent 0%, #000 50%, #000 100%); mask-image: linear-gradient(to left, transparent 0%, #000 50%, #000 100%); }
  /* Grid view, scrolled: a frosted bar behind the header, its edge a hairline
     a little below the header's controls; anything scrolled under it is
     heavily blurred. One backdrop layer (cheap), with a little grain. */
  .top-scrim {
    display: none;
    position: fixed; left: 0; right: 0; top: 0; z-index: 25; pointer-events: none;
    height: calc(env(safe-area-inset-top, 0px) + var(--top-bar-height));
    background: var(--color-top-bar);
    border-bottom: 1px solid var(--color-divider);
    -webkit-backdrop-filter: blur(var(--top-bar-blur)) saturate(var(--glass-saturate));
    backdrop-filter: blur(var(--top-bar-blur)) saturate(var(--glass-saturate));
    opacity: 0; transition: opacity 0.3s ease-out;
  }
  :global(.js) .top-scrim { display: block; }
  :global(html[data-grid-scrolled]) .top-scrim { opacity: calc(1 - var(--lb, 0)); }   /* fades out as a cover opens */
  :global(html[data-focus]) .top-scrim { transition: none; }   /* following the cover, not lagging behind it */
  .top-scrim::before {
    content: ""; position: absolute; inset: 0;
    background-image: var(--grain); background-size: var(--grain-size) var(--grain-size);
    filter: var(--top-scrim-grain-filter); opacity: var(--top-scrim-grain);
  }
  .edge i:nth-child(8) { right: 87.5%; width: 12.5%; -webkit-mask-image: linear-gradient(to left, transparent 0%, #000 100%); mask-image: linear-gradient(to left, transparent 0%, #000 100%); }
</style>
