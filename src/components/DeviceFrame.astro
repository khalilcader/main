---
/*
  Phone mock from Figma (node 43:64): frosted glass frame with a 2px inside
  rim, white screen. Corners use Figma's 60% smoothing (scripts/squircle.ts).
  Pass `src` for an image or video (.mp4/.webm) to fill the screen.
*/
interface Props {
  src?: string;
  alt?: string;
}
const { src, alt = '' } = Astro.props;
const isVideo = src ? /\.(mp4|webm)$/i.test(src) : false;
---
<div class="device" data-device>
  <div class="device__shadow"></div>
  <div class="device__frame" data-device-frame>
    <svg class="device__rim" aria-hidden="true"><path data-device-rim /></svg>
    <div class="device__screen" data-device-screen>
      {src && (isVideo
        ? <video src={src} autoplay muted loop playsinline aria-label={alt}></video>
        : <img src={src} alt={alt} loading="lazy" />)}
      <slot />
    </div>
  </div>
</div>

<script>
  import { clipSquircle } from '../scripts/squircle';

  for (const device of document.querySelectorAll<HTMLElement>('[data-device]')) {
    const frame = device.querySelector<HTMLElement>('[data-device-frame]')!;
    const screen = device.querySelector<HTMLElement>('[data-device-screen]')!;
    const rim = device.querySelector<SVGPathElement>('[data-device-rim]')!;
    const css = getComputedStyle(device);
    const px = (name: string) => parseFloat(css.getPropertyValue(name));
    const smoothing = px('--corner-smoothing');
    // Radii are Figma's values at full size; scale them with the device.
    const scale = () => device.offsetWidth / px('--device-width');

    clipSquircle(frame, () => px('--radius-device') * scale(), smoothing, (d, w, h) => {
      rim.ownerSVGElement!.setAttribute('viewBox', `0 0 ${w} ${h}`);
      rim.setAttribute('d', d);
    });
    clipSquircle(screen, () => px('--radius-screen') * scale(), smoothing);
  }
</script>

<style>
  /*
    Sized by height so it always fits the stage; proportions from Figma
    (tokens in Figma px). cqw resolves against .device: 1cqw = 1% of its width.
  */
  .device {
    container-type: inline-size;
    position: relative;
    flex: none;
    height: min(calc(var(--device-height) * 1px), 100%);
    aspect-ratio: var(--device-width) / var(--device-height);
  }
  .device__shadow,
  .device__frame {
    position: absolute;
    inset: 0;
    border-radius: calc(var(--radius-device) / var(--device-width) * 100cqw);
  }
  /* A clip path would cut off the shadow, so it lives on its own layer. */
  .device__shadow { box-shadow: var(--shadow-device); }
  .device__frame { background: var(--color-device-glass); }
  .device__rim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* Stroke is centred on the path and the frame clips the outer half,
     leaving an inside stroke like Figma's. */
  .device__rim path {
    fill: none;
    stroke: var(--color-device-rim);
    stroke-width: calc(var(--device-rim) * 2px);
  }
  .device__screen {
    position: absolute;
    inset: calc(var(--device-bezel) / var(--device-width) * 100cqw);
    overflow: hidden;
    background: var(--color-screen);
    border-radius: calc(var(--radius-screen) / var(--device-width) * 100cqw);
  }
  .device__screen :is(img, video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
