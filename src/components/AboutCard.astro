---
import Tooltip from './Tooltip.astro';

// The About card. Clicking the avatar grows it out of the avatar's About side
// (photo side first), turning 180° in 3D as it goes (src/scripts/about-card.ts).
// Edit the copy below.
import { photo } from '../photo';
// Where Khalil has worked, newest first, in years (no months).
const jobs = [
  { company: 'Anthropic', from: 2025, to: 'Present' },
  { company: 'Figma', from: 2022, to: 2025 },
  { company: 'Instagram', from: 2020, to: 2022 },
  { company: 'Google', from: 2015, to: 2020 },
];
---
<div class="about-scrim" id="about-scrim" hidden></div>
<!-- Grain on its own layer above the blur, so its blend works on the page
     (inside the blurred layer it could only blend with that layer). -->
<div class="about-grain" id="about-grain" aria-hidden="true" hidden></div>
<div class="about" id="about" role="dialog" aria-modal="true" aria-label="About" hidden>
  <div class="about-card" id="about-card">
    <!-- Each face is a plane in the 3D turn; the surface inside carries the
         smoothed shape (Chrome ignores clip-path inside a 3D scene). -->
    <div class="about-face about-front"><div class="about-surface" data-smooth="clip">
      <!-- The Tree Shadow daylight shader behind the copy. -->
      <canvas class="about-daylight" aria-hidden="true"></canvas>
      <!-- Brooklyn, by day or by night with the theme: a sharp scene over a
           blurred halo of itself, both easing out in an oval, under a little
           grain, and blended with the daylight shader beneath. -->
      <div class="about-scene" aria-hidden="true">
        {['halo', 'sharp'].map((layer) => (
          <div class={`scene-layer ${layer}`}>
            <img class="day" src={`${import.meta.env.BASE_URL}images/about-nyc-light.webp`} alt="" width="1000" height="1000" />
            <img class="night" src={`${import.meta.env.BASE_URL}images/about-nyc-dark.webp`} alt="" width="1000" height="1000" />
          </div>
        ))}
        <div class="scene-grain"></div>
      </div>
      <div class="about-body">
        <div class="about-copy">
          <p>Hi, I’m Khalil. I’m a product designer who designs tools that shape how people think, collaborate, and create. I’m currently a Member of Technical Staff at Anthropic, where I design interfaces for <span class="nowrap">human-AI</span> interaction.</p>
          <p>I’m currently based in New York City.</p>
        </div>
        <ul class="about-jobs" aria-label="Experience">
          {jobs.map((j) => (
            <li>
              <span class="job-company">{j.company}</span>
              <span class="job-years">{j.from} – {j.to}</span>
            </li>
          ))}
        </ul>
      </div>
      <button class="about-close has-tip" data-smooth="surface" data-cursor="halo" id="about-close" type="button" aria-label="Close" aria-keyshortcuts="Escape">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M7 7l10 10M17 7L7 17" />
        </svg>
        <Tooltip shortcut="Esc" below>Close</Tooltip>
      </button>
    </div></div>
    <!-- The small side matches whatever the avatar shows: the book it has
         flipped to on hover when the card opens, your photo when it closes back. -->
    <div class="about-face about-back" aria-hidden="true"><div class="about-surface" data-smooth="clip">
      {photo && <img class="about-back-photo" src={photo} alt="" />}
      <svg class="about-back-book" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7.75 2.75V2C5.67893 2 4 3.67893 4 5.75H4.75H5.5C5.5 4.50736 6.50736 3.5 7.75 3.5V2.75ZM7.75 2.75V3.5H16.25V2.75V2H7.75V2.75ZM16.25 2.75V3.5C17.4926 3.5 18.5 4.50736 18.5 5.75H19.25H20C20 3.67893 18.3211 2 16.25 2V2.75ZM19.25 5.75H18.5V18.25H19.25H20V5.75H19.25ZM19.25 18.25H18.5C18.5 19.4926 17.4926 20.5 16.25 20.5V21.25V22C18.3211 22 20 20.3211 20 18.25H19.25ZM16.25 21.25V20.5H7.75V21.25V22H16.25V21.25ZM7.75 21.25V20.5C6.50736 20.5 5.5 19.4926 5.5 18.25H4.75H4C4 20.3211 5.67893 22 7.75 22V21.25ZM4.75 18.25H5.5V5.75H4.75H4V18.25H4.75Z" fill="currentColor" stroke="none" />
        <path d="M8.75 6.75H15.25M8.75 10.75H15.25M8.75 14.75H11.25" />
      </svg>
    </div></div>
  </div>
</div>

<script>
  import '../scripts/about-card';
  import { mountTreeShadow } from '../scripts/tree-shadow';
  const daylight = document.querySelector<HTMLCanvasElement>('.about-daylight');
  // Set up after load, in idle time; the tree texture itself grows in a
  // worker. The shader then runs only while the card is open (it's
  // display: none otherwise).
  const mount = () => {
    if (!daylight) return;
    try { mountTreeShadow(daylight); } catch (err) { console.warn('Daylight shader failed', err); }
  };
  const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn) : setTimeout(fn, 200));
  if (document.readyState === 'complete') idle(mount);
  else addEventListener('load', () => idle(mount), { once: true });
</script>

<style>
  /* Blurs the page behind the card, with a fine grain. */
  .about-scrim {
    position: fixed; inset: 0; z-index: 60;
    background: var(--color-scrim);
    -webkit-backdrop-filter: blur(var(--about-blur)); backdrop-filter: blur(var(--about-blur));
    opacity: 0;
  }
  .about-grain {
    position: fixed; inset: 0; z-index: 60; pointer-events: none;
    background-image: var(--grain); background-size: var(--grain-size) var(--grain-size);
    mix-blend-mode: var(--scrim-grain-blend); filter: var(--scrim-grain-filter);   /* overlay; plain dark speckles in dark mode */
    opacity: 0;   /* fades to --scrim-grain with the scrim (script) */
  }
  .about-scrim[hidden], .about-grain[hidden], .about[hidden] { display: none; }

  .about {
    position: fixed; inset: 0; z-index: 61;
    display: flex; align-items: center; justify-content: center;
    padding: var(--gutter);
    pointer-events: none;
  }
  /* Portrait, in the avatar's proportions (50 × 56), as tall as fits. */
  .about-card {
    position: relative;
    height: min(var(--about-height), calc(100dvh - 2 * var(--gutter)), calc((100vw - 2 * var(--gutter)) * 56 / 50));
    aspect-ratio: 50 / 56;
    transform-style: preserve-3d;
    box-shadow: var(--about-shadow);   /* the faces are clipped, so the shadow lives here */
    border-radius: calc(var(--about-radius) * (1 + var(--corner-smoothing)));   /* inside the smoothed outline */
    pointer-events: auto;
  }
  .about-face {
    -webkit-backface-visibility: hidden; backface-visibility: hidden;
  }
  .about-front { position: relative; height: 100%; }
  .about-back { position: absolute; inset: 0; transform: rotateY(180deg); }
  .about-surface {
    --surface-border: var(--color-cover-border);
    position: relative; height: 100%;
    border: 1px solid var(--surface-border);
    border-radius: var(--about-radius);
    background: var(--color-cover-bg);
  }
  /* Wider than the card (which clips it): the shader composes its light for
     a landscape frame, as in the artifact, and the card shows the left, lit
     part of it. On a portrait canvas the flare lands opposite the beams. */
  .about-daylight {
    position: absolute; left: 0; top: 0; width: 150%; height: 100%; display: block;
    background: var(--color-daylight-paper);   /* without WebGL2 */
  }
  /* The copy: large, set in the card's own units (cqh) so it scales with it. */
  .about-front .about-surface { container-type: size; }
  /* Bio under the scene, résumé along the bottom. */
  .about-body {
    position: absolute; left: var(--about-pad); right: var(--about-pad); bottom: var(--about-pad);
    top: calc(var(--about-scene-top) + var(--about-scene-height) - var(--about-scene-overlap));   /* where the scene's fade trails off */
    display: flex; flex-direction: column; gap: var(--about-body-gap);
  }
  /* The illustration at the top, inset to line up with the text (its
     feathered edges reach a little past it), below the close button. Its edges dissolve along long, eased
     feathers on all four sides, the halo reaching further. Light mode
     multiplies it with the daylight, so the leaf shadows fall across it;
     dark mode screens it, so the shader's glow sits over it. */
  .about-scene {
    position: absolute; top: var(--about-scene-top);
    left: calc(var(--about-pad) - var(--about-scene-bleed)); right: calc(var(--about-pad) - var(--about-scene-bleed));
    height: var(--about-scene-height);
    pointer-events: none;
    mix-blend-mode: var(--about-scene-blend);
  }
  .scene-layer { position: absolute; inset: 0; }
  .scene-layer img {
    position: absolute; inset: 0; width: 100%; height: 100%; max-width: none;
    object-fit: cover; object-position: 50% 72%;   /* skyline to the cab */
  }
  .scene-layer .day { opacity: var(--about-scene-day); }
  .scene-layer .night { opacity: calc(1 - var(--about-scene-day)); }
  .scene-layer.sharp {
    -webkit-mask-image: var(--about-scene-feather-x), var(--about-scene-feather-y), var(--about-scene-round); -webkit-mask-composite: source-in, source-in;
    mask-image: var(--about-scene-feather-x), var(--about-scene-feather-y), var(--about-scene-round); mask-composite: intersect;
  }
  .scene-layer.halo {
    filter: blur(var(--about-scene-halo-blur)); opacity: var(--about-scene-halo);
    transform: scale(1.04);
    -webkit-mask-image: var(--about-scene-halo-x), var(--about-scene-halo-y), var(--about-scene-halo-round); -webkit-mask-composite: source-in, source-in;
    mask-image: var(--about-scene-halo-x), var(--about-scene-halo-y), var(--about-scene-halo-round); mask-composite: intersect;
  }
  .scene-grain {
    position: absolute; inset: 0; pointer-events: none;
    background-image: var(--grain); background-size: var(--grain-size) var(--grain-size);
    mix-blend-mode: overlay; opacity: var(--about-scene-grain);
    -webkit-mask-image: var(--about-scene-feather-x), var(--about-scene-feather-y), var(--about-scene-round); -webkit-mask-composite: source-in, source-in;
    mask-image: var(--about-scene-feather-x), var(--about-scene-feather-y), var(--about-scene-round); mask-composite: intersect;
  }
  .about-copy {
    flex: none;
    color: var(--color-fg);
    font-size: clamp(13px, var(--about-text-size), 32px); font-weight: var(--text-name-weight);
    line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty;
  }
  .about-copy p { margin: 0; }
  .about-copy p + p { margin-top: 0.6em; }
  .nowrap { white-space: nowrap; }

  /* A short résumé along the bottom: company and years, in rows
     between hairline dividers. */
  .about-jobs {
    flex: none; margin: auto 0 0; padding: 0; list-style: none;
    font-size: clamp(13px, var(--job-text-size), var(--text-name-size)); font-weight: var(--text-name-weight); letter-spacing: var(--text-name-tracking);
    color: var(--color-fg);
  }
  .about-jobs li {
    display: flex; align-items: center; gap: var(--job-gap);
    padding: var(--job-row-pad) 0;
    border-top: 1px solid var(--color-divider);
  }
  .about-jobs li:first-child { border-top: 0; }
  .job-company { flex: 1; }
  .job-years { opacity: var(--text-secondary-opacity); font-weight: 400; letter-spacing: 0; }
  .about-back .about-surface {
    display: flex; align-items: center; justify-content: center;
    color: var(--color-fg);
  }
  .about-back-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Sized by script to match the avatar's 24px icon at the small end. */
  .about-back-book { display: none; width: var(--about-back-icon, 24px); height: var(--about-back-icon, 24px); opacity: var(--photo-back-icon-opacity); }
  .about-card[data-small="book"] .about-back-photo { display: none; }
  .about-card[data-small="book"] .about-back-book { display: block; }

  .about-close {
    /* Inset from the card's outer edge (the surface has a 1px border). */
    position: absolute; top: calc(var(--about-close-inset) - 1px); left: calc(var(--about-close-inset) - 1px);
    width: var(--button-size); height: var(--button-size); padding: var(--button-pad);
    display: inline-flex; align-items: center; justify-content: center;
    --surface-bg: transparent; --surface-border: transparent; --surface-blur: none;
    border: 0; border-radius: var(--button-radius); background: var(--surface-bg);
    color: var(--color-fg); cursor: pointer;
  }
  @media (hover: hover) { .about-close:hover { --surface-bg: var(--color-tool-hover-bg); } }
  /* The custom cursor's halo is its hover highlight: no tile as well. */
  @media (hover: hover) { :global(html.has-cursor) .about-close:hover { --surface-bg: transparent; } }
  .about-close:focus-visible { outline: none; --surface-bg: var(--color-tool-hover-bg); }
  .about-close svg { width: var(--icon-size); height: var(--icon-size); }

</style>
