---
import { existsSync } from 'node:fs';
import Tooltip from './Tooltip.astro';

// The About card. Clicking the avatar grows it out of the avatar's About side
// (photo side first), turning 180° in 3D as it goes (src/scripts/about-card.ts).
// Edit the copy below.
const photo = existsSync('public/images/khalil.jpg') ? `${import.meta.env.BASE_URL}images/khalil.jpg` : null;
---
<div class="about-scrim" id="about-scrim" hidden></div>
<div class="about" id="about" role="dialog" aria-modal="true" aria-labelledby="about-title" hidden>
  <div class="about-card" id="about-card">
    <!-- Each face is a plane in the 3D turn; the surface inside carries the
         smoothed shape (Chrome ignores clip-path inside a 3D scene). -->
    <div class="about-face about-front"><div class="about-surface" data-smooth="clip">
      <button class="about-close has-tip" data-smooth="surface" id="about-close" type="button" aria-label="Close" aria-keyshortcuts="Escape">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M7 7l10 10M17 7L7 17" />
        </svg>
        <Tooltip shortcut="Esc" below>Close</Tooltip>
      </button>
      <span class="about-photo-wrap">
        <span class="about-photo" data-smooth="clip">
          {photo && <img src={photo} alt="" width="50" height="56" />}
        </span>
      </span>
      <h2 class="about-name" id="about-title">Khalil Cader</h2>
      <p class="about-role">Product Designer</p>
      <!-- Placeholder copy: replace with your own. -->
      <div class="about-body">
        <p>A few lines about who you are, what you design, and what you care about.</p>
        <p>Where you've worked, and what you're looking for next.</p>
      </div>
    </div></div>
    <!-- The small side: your photo, matching the avatar, so the card opens out
         of it and closes back into it. -->
    <div class="about-face about-back" aria-hidden="true"><div class="about-surface" data-smooth="clip">
      {photo && <img class="about-back-photo" src={photo} alt="" />}
    </div></div>
  </div>
</div>

<script>
  import '../scripts/about-card';
</script>

<style>
  /* Blurs the page behind the card, with a fine grain. */
  .about-scrim {
    position: fixed; inset: 0; z-index: 60;
    background: var(--color-scrim);
    -webkit-backdrop-filter: blur(var(--about-blur)); backdrop-filter: blur(var(--about-blur));
    opacity: 0;
  }
  .about-scrim::after {
    content: ""; position: absolute; inset: 0;
    background-image: var(--grain); background-size: var(--grain-size) var(--grain-size);
    mix-blend-mode: overlay; opacity: var(--about-grain);
  }
  .about-scrim[hidden], .about[hidden] { display: none; }

  .about {
    position: fixed; inset: 0; z-index: 61;
    display: flex; align-items: center; justify-content: center;
    padding: var(--gutter);
    pointer-events: none;
  }
  /* Portrait, in the avatar's proportions (50 × 56), as tall as fits. */
  .about-card {
    position: relative;
    height: min(var(--about-height), calc(100dvh - 2 * var(--gutter)), calc((100vw - 2 * var(--gutter)) * 56 / 50));
    aspect-ratio: 50 / 56;
    transform-style: preserve-3d;
    border-radius: var(--about-radius);
    box-shadow: var(--about-shadow);   /* the faces are clipped, so the shadow lives here */
    pointer-events: auto;
  }
  .about-face {
    -webkit-backface-visibility: hidden; backface-visibility: hidden;
  }
  .about-front { position: relative; height: 100%; }
  .about-back { position: absolute; inset: 0; transform: rotateY(180deg); }
  .about-surface {
    --surface-border: var(--color-cover-border);
    position: relative; height: 100%;
    border: 1px solid var(--surface-border);
    border-radius: var(--about-radius);
    background: var(--color-cover-bg);
  }
  .about-front .about-surface {
    padding: var(--about-pad);
    display: flex; flex-direction: column; overflow: auto;
  }
  .about-back .about-surface {
    display: flex; align-items: center; justify-content: center;
    color: var(--color-fg);
  }
  .about-back-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .about-close {
    position: absolute; top: var(--space-3); right: var(--space-3);
    width: var(--button-size); height: var(--button-size); padding: var(--button-pad);
    display: inline-flex; align-items: center; justify-content: center;
    --surface-bg: transparent; --surface-border: transparent; --surface-blur: none;
    border: 0; border-radius: var(--button-radius); background: var(--surface-bg);
    color: var(--color-fg); cursor: pointer;
  }
  @media (hover: hover) { .about-close:hover { --surface-bg: var(--color-tool-hover-bg); } }
  .about-close:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .about-close svg { width: var(--icon-size); height: var(--icon-size); }

  .about-photo-wrap {
    display: block; flex: none; width: var(--photo-width); height: var(--photo-height);
    margin-bottom: var(--space-4);
    border-radius: var(--photo-radius); box-shadow: var(--photo-shadow);
  }
  .about-photo {
    --surface-border: var(--color-photo-border);
    display: block; width: 100%; height: 100%;
    border: 1px solid var(--surface-border); border-radius: var(--photo-radius);
    background: var(--color-cover-bg); overflow: hidden;
  }
  .about-photo img { width: 100%; height: 100%; object-fit: cover; }
  .about-name, .about-role {
    margin: 0;
    font-size: var(--text-name-size); font-weight: var(--text-name-weight);
    letter-spacing: var(--text-name-tracking); line-height: normal;
  }
  .about-role { opacity: var(--text-secondary-opacity); }
  .about-body { margin-top: var(--space-4); font-size: var(--about-text-size); line-height: 1.5; }
  .about-body p { margin: 0 0 var(--space-3); }
  .about-body p:last-child { margin-bottom: 0; }
</style>
