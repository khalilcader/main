---
import Tooltip from './Tooltip.astro';

// The About card. Clicking the avatar grows it out of the avatar's About side
// (photo side first), turning 180° in 3D as it goes (src/scripts/about-card.ts).
// Edit the copy below.
import { photo } from '../photo';
// Where Khalil has worked, newest first, in years (no months). Logos are
// from SVG Logos (gilbarbara/logos, CC0), in their brand colours; Anthropic's
// black mark follows the theme instead, and Instagram's glyph takes its
// brand gradient.
const jobs = [
  { company: 'Anthropic', from: 2025, to: 'Present', viewBox: '0 0 256 176', logo: '<path fill="currentColor" d="m147.487 0l70.081 175.78H256L185.919 0zM66.183 106.221l23.98-61.774l23.98 61.774zM70.07 0L0 175.78h39.18l14.33-36.914h73.308l14.328 36.914h39.179L110.255 0z"/>' },
  { company: 'Figma', from: 2022, to: 2025, viewBox: '0 0 256 384', logo: '<path fill="#0acf83" d="M64 384c35.328 0 64-28.672 64-64v-64H64c-35.328 0-64 28.672-64 64s28.672 64 64 64"/><path fill="#a259ff" d="M0 192c0-35.328 28.672-64 64-64h64v128H64c-35.328 0-64-28.672-64-64"/><path fill="#f24e1e" d="M0 64C0 28.672 28.672 0 64 0h64v128H64C28.672 128 0 99.328 0 64"/><path fill="#ff7262" d="M128 0h64c35.328 0 64 28.672 64 64s-28.672 64-64 64h-64z"/><path fill="#1abcfe" d="M256 192c0 35.328-28.672 64-64 64s-64-28.672-64-64s28.672-64 64-64s64 28.672 64 64"/>' },
  { company: 'Instagram', from: 2020, to: 2022, viewBox: '0 0 256 256', logo: '<defs><radialGradient id="instagram-icon-g" cx="0.28" cy="1.05" r="1.25"><stop offset="0" stop-color="#fd5"/><stop offset="0.1" stop-color="#fd5"/><stop offset="0.5" stop-color="#ff543e"/><stop offset="1" stop-color="#c837ab"/></radialGradient></defs><path fill="url(#instagram-icon-g)" d="M128 23.064c34.177 0 38.225.13 51.722.745c12.48.57 19.258 2.655 23.769 4.408c5.974 2.322 10.238 5.096 14.717 9.575s7.253 8.743 9.575 14.717c1.753 4.511 3.838 11.289 4.408 23.768c.615 13.498.745 17.546.745 51.723s-.13 38.226-.745 51.723c-.57 12.48-2.655 19.257-4.408 23.768c-2.322 5.974-5.096 10.239-9.575 14.718s-8.743 7.253-14.717 9.574c-4.511 1.753-11.289 3.839-23.769 4.408c-13.495.616-17.543.746-51.722.746s-38.228-.13-51.723-.746c-12.48-.57-19.257-2.655-23.768-4.408c-5.974-2.321-10.239-5.095-14.718-9.574c-4.479-4.48-7.253-8.744-9.574-14.718c-1.753-4.51-3.839-11.288-4.408-23.768c-.616-13.497-.746-17.545-.746-51.723s.13-38.225.746-51.722c.57-12.48 2.655-19.258 4.408-23.769c2.321-5.974 5.095-10.238 9.574-14.717c4.48-4.48 8.744-7.253 14.718-9.575c4.51-1.753 11.288-3.838 23.768-4.408c13.497-.615 17.545-.745 51.723-.745M128 0C93.237 0 88.878.147 75.226.77c-13.625.622-22.93 2.786-31.071 5.95c-8.418 3.271-15.556 7.648-22.672 14.764S9.991 35.738 6.72 44.155C3.555 52.297 1.392 61.602.77 75.226C.147 88.878 0 93.237 0 128s.147 39.122.77 52.774c.622 13.625 2.785 22.93 5.95 31.071c3.27 8.417 7.647 15.556 14.763 22.672s14.254 11.492 22.672 14.763c8.142 3.165 17.446 5.328 31.07 5.95c13.653.623 18.012.77 52.775.77s39.122-.147 52.774-.77c13.624-.622 22.929-2.785 31.07-5.95c8.418-3.27 15.556-7.647 22.672-14.763s11.493-14.254 14.764-22.672c3.164-8.142 5.328-17.446 5.95-31.07c.623-13.653.77-18.012.77-52.775s-.147-39.122-.77-52.774c-.622-13.624-2.786-22.929-5.95-31.07c-3.271-8.418-7.648-15.556-14.764-22.672S220.262 9.99 211.845 6.72c-8.142-3.164-17.447-5.328-31.071-5.95C167.122.147 162.763 0 128 0m0 62.27c-36.302 0-65.73 29.43-65.73 65.73s29.428 65.73 65.73 65.73c36.301 0 65.73-29.428 65.73-65.73c0-36.301-29.429-65.73-65.73-65.73m0 108.397c-23.564 0-42.667-19.103-42.667-42.667S104.436 85.333 128 85.333s42.667 19.103 42.667 42.667s-19.103 42.667-42.667 42.667m83.686-110.994c0 8.484-6.876 15.36-15.36 15.36s-15.36-6.876-15.36-15.36s6.877-15.36 15.36-15.36s15.36 6.877 15.36 15.36"/>' },
  { company: 'Google', from: 2015, to: 2020, viewBox: '0 0 256 262', logo: '<path fill="#4285f4" d="M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622l38.755 30.023l2.685.268c24.659-22.774 38.875-56.282 38.875-96.027"/><path fill="#34a853" d="M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055c-34.523 0-63.824-22.773-74.269-54.25l-1.531.13l-40.298 31.187l-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1"/><path fill="#fbbc05" d="M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82c0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602z"/><path fill="#eb4335" d="M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0C79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251"/>' },
];
---
<div class="about-scrim" id="about-scrim" hidden></div>
<!-- Grain on its own layer above the blur, so its blend works on the page
     (inside the blurred layer it could only blend with that layer). -->
<div class="about-grain" id="about-grain" aria-hidden="true" hidden></div>
<div class="about" id="about" role="dialog" aria-modal="true" aria-label="About" hidden>
  <div class="about-card" id="about-card">
    <!-- Each face is a plane in the 3D turn; the surface inside carries the
         smoothed shape (Chrome ignores clip-path inside a 3D scene). -->
    <div class="about-face about-front"><div class="about-surface" data-smooth="clip">
      <!-- The Tree Shadow daylight shader behind the copy. -->
      <canvas class="about-daylight" aria-hidden="true"></canvas>
      <div class="about-copy">
        <p>Hi, I’m Khalil. I’m a product designer who designs tools that shape how people think, collaborate, and create. I’m currently a Member of Technical Staff at Anthropic, where I design interfaces for <span class="nowrap">human-AI</span> interaction.</p>
      </div>
      <ul class="about-jobs" aria-label="Experience">
        {jobs.map((j) => (
          <li>
            <span class="job-logo" data-smooth="clip">
              <svg viewBox={j.viewBox} aria-hidden="true" set:html={j.logo} />
            </span>
            <span class="job-company">{j.company}</span>
            <span class="job-years">{j.from} – {j.to}</span>
          </li>
        ))}
      </ul>
      <button class="about-close has-tip" data-smooth="surface" data-cursor="halo" id="about-close" type="button" aria-label="Close" aria-keyshortcuts="Escape">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M7 7l10 10M17 7L7 17" />
        </svg>
        <Tooltip shortcut="Esc" below>Close</Tooltip>
      </button>
    </div></div>
    <!-- The small side matches whatever the avatar shows: the book it has
         flipped to on hover when the card opens, your photo when it closes back. -->
    <div class="about-face about-back" aria-hidden="true"><div class="about-surface" data-smooth="clip">
      {photo && <img class="about-back-photo" src={photo} alt="" />}
      <svg class="about-back-book" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17.25 2.75H6.75C5.64543 2.75 4.75 3.64543 4.75 4.75V19.25C4.75 20.3546 5.64543 21.25 6.75 21.25H17.25C18.3546 21.25 19.25 20.3546 19.25 19.25V4.75C19.25 3.64543 18.3546 2.75 17.25 2.75Z" />
        <path d="M19.25 12V14.75C19.25 15.8546 18.3546 16.75 17.25 16.75H7C5.75736 16.75 4.75 17.7574 4.75 19C4.75 20.2426 5.75736 21.25 7 21.25H10" />
        <path d="M8.75 7H15.25M8.75 11H12.25" />
      </svg>
    </div></div>
  </div>
</div>

<script>
  import '../scripts/about-card';
  import { mountTreeShadow } from '../scripts/tree-shadow';
  const daylight = document.querySelector<HTMLCanvasElement>('.about-daylight');
  // Set up after load, in idle time; the tree texture itself grows in a
  // worker. The shader then runs only while the card is open (it's
  // display: none otherwise).
  const mount = () => {
    if (!daylight) return;
    try { mountTreeShadow(daylight); } catch (err) { console.warn('Daylight shader failed', err); }
  };
  const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn) : setTimeout(fn, 200));
  if (document.readyState === 'complete') idle(mount);
  else addEventListener('load', () => idle(mount), { once: true });
</script>

<style>
  /* Blurs the page behind the card, with a fine grain. */
  .about-scrim {
    position: fixed; inset: 0; z-index: 60;
    background: var(--color-scrim);
    -webkit-backdrop-filter: blur(var(--about-blur)); backdrop-filter: blur(var(--about-blur));
    opacity: 0;
  }
  .about-grain {
    position: fixed; inset: 0; z-index: 60; pointer-events: none;
    background-image: var(--grain); background-size: var(--grain-size) var(--grain-size);
    mix-blend-mode: var(--scrim-grain-blend); filter: var(--scrim-grain-filter);   /* overlay; plain dark speckles in dark mode */
    opacity: 0;   /* fades to --scrim-grain with the scrim (script) */
  }
  .about-scrim[hidden], .about-grain[hidden], .about[hidden] { display: none; }

  .about {
    position: fixed; inset: 0; z-index: 61;
    display: flex; align-items: center; justify-content: center;
    padding: var(--gutter);
    pointer-events: none;
  }
  /* Portrait, in the avatar's proportions (50 × 56), as tall as fits. */
  .about-card {
    position: relative;
    height: min(var(--about-height), calc(100dvh - 2 * var(--gutter)), calc((100vw - 2 * var(--gutter)) * 56 / 50));
    aspect-ratio: 50 / 56;
    transform-style: preserve-3d;
    box-shadow: var(--about-shadow);   /* the faces are clipped, so the shadow lives here */
    border-radius: calc(var(--about-radius) * (1 + var(--corner-smoothing)));   /* inside the smoothed outline */
    pointer-events: auto;
  }
  .about-face {
    -webkit-backface-visibility: hidden; backface-visibility: hidden;
  }
  .about-front { position: relative; height: 100%; }
  .about-back { position: absolute; inset: 0; transform: rotateY(180deg); }
  .about-surface {
    --surface-border: var(--color-cover-border);
    position: relative; height: 100%;
    border: 1px solid var(--surface-border);
    border-radius: var(--about-radius);
    background: var(--color-cover-bg);
  }
  /* Wider than the card (which clips it): the shader composes its light for
     a landscape frame, as in the artifact, and the card shows the left, lit
     part of it. On a portrait canvas the flare lands opposite the beams. */
  .about-daylight {
    position: absolute; left: 0; top: 0; width: 150%; height: 100%; display: block;
    background: var(--color-daylight-paper);   /* without WebGL2 */
  }
  /* The copy: large, set in the card's own units (cqh) so it scales with it. */
  .about-front .about-surface { container-type: size; }
  .about-copy {
    position: absolute; left: var(--about-pad); right: var(--about-pad);
    top: calc(var(--about-close-inset) + var(--button-size) + var(--about-copy-gap));
    color: var(--color-fg);
    font-size: clamp(18px, var(--about-text-size), 32px); font-weight: var(--text-name-weight);
    line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty;
  }
  .about-copy p { margin: 0; }
  .nowrap { white-space: nowrap; }

  /* A short résumé along the bottom: logo, company and years, in rows
     between hairline dividers. */
  .about-jobs {
    position: absolute; left: var(--about-pad); right: var(--about-pad); bottom: var(--about-pad);
    margin: 0; padding: 0; list-style: none;
    font-size: var(--text-name-size); font-weight: var(--text-name-weight); letter-spacing: var(--text-name-tracking);
    color: var(--color-fg);
  }
  .about-jobs li {
    display: flex; align-items: center; gap: var(--job-gap);
    padding: var(--job-row-pad) 0;
    border-top: 1px solid var(--color-divider);
  }
  .about-jobs li:first-child { border-top: 0; }
  /* Liquid glass: a translucent tile that lifts the colour behind it, lit
     along its top edge, with a soft gloss and a hairline rim. */
  .job-logo {
    position: relative; isolation: isolate;
    flex: none; width: var(--job-logo-size); height: var(--job-logo-size);
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--job-glass-bg);
    -webkit-backdrop-filter: blur(12px) saturate(var(--glass-saturate)); backdrop-filter: blur(12px) saturate(var(--glass-saturate));
    box-shadow: var(--job-glass-shadow);
    --surface-border: var(--color-job-glass-rim);
    border: 1px solid var(--surface-border); border-radius: var(--job-logo-radius);
  }
  .job-logo::after {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(120% 70% at 30% 0%, var(--color-job-glass-gloss), transparent 60%);
  }
  .job-logo svg { width: 55%; height: 55%; }
  .job-company { flex: 1; }
  .job-years { opacity: var(--text-secondary-opacity); font-weight: 400; letter-spacing: 0; }
  .about-back .about-surface {
    display: flex; align-items: center; justify-content: center;
    color: var(--color-fg);
  }
  .about-back-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Sized by script to match the avatar's 24px icon at the small end. */
  .about-back-book { display: none; width: var(--about-back-icon, 24px); height: var(--about-back-icon, 24px); opacity: var(--photo-back-icon-opacity); }
  .about-card[data-small="book"] .about-back-photo { display: none; }
  .about-card[data-small="book"] .about-back-book { display: block; }

  .about-close {
    /* Inset from the card's outer edge (the surface has a 1px border). */
    position: absolute; top: calc(var(--about-close-inset) - 1px); left: calc(var(--about-close-inset) - 1px);
    width: var(--button-size); height: var(--button-size); padding: var(--button-pad);
    display: inline-flex; align-items: center; justify-content: center;
    --surface-bg: transparent; --surface-border: transparent; --surface-blur: none;
    border: 0; border-radius: var(--button-radius); background: var(--surface-bg);
    color: var(--color-fg); cursor: pointer;
  }
  @media (hover: hover) { .about-close:hover { --surface-bg: var(--color-tool-hover-bg); } }
  /* The custom cursor's halo is its hover highlight: no tile as well. */
  @media (hover: hover) { :global(html.has-cursor) .about-close:hover { --surface-bg: transparent; } }
  .about-close:focus-visible { outline: none; --surface-bg: var(--color-tool-hover-bg); }
  .about-close svg { width: var(--icon-size); height: var(--icon-size); }

</style>
