---
// Figma 43:66: the glassy device frame a screen recording plays in.
// Sized in percentages so it scales with the cover.
interface Props {
  webm?: string;
  mp4: string;
  poster: string;
}
const { webm, mp4, poster } = Astro.props;
---
<div class="glass">
  <video poster={poster} muted loop playsinline autoplay preload="metadata">
    {webm && <source src={webm} type="video/webm" />}
    <source src={mp4} type="video/mp4" />
  </video>
</div>

<style>
  .glass {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    height: 86%; aspect-ratio: 390 / 816;
    padding: var(--glass-pad);
    border: var(--glass-border-width) solid var(--color-glass-border);
    border-radius: var(--glass-radius-x) / var(--glass-radius-y);
    background: var(--color-glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)); backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--glass-shadow);
  }
  video {
    width: 100%; height: 100%; object-fit: cover;
    border-radius: var(--glass-screen-radius-x) / var(--glass-screen-radius-y);
  }
</style>
