---
// The device a screen recording plays in: Khalil's device frame image
// (transparent screen) over the video. Sized in percentages so it scales with
// the cover. The screen sits in the frame's opening, reaching a little under
// the frame so no gap shows at its edge. Each device's image size, opening and
// screen corner, in the image's pixels:
interface Props {
  webm?: string;
  mp4: string;
  poster: string;
  start?: number;   // seconds; the frame the cover rests on
  camera?: [number, number, number, number][];   // see scripts/camera.ts
  device?: 'iphone' | 'iphone-notch' | 'iphone-recorded' | 'ipad' | 'desktop' | 'desktop-wide' | 'desktop-mac' | 'desktop-app' | 'film';
  rest?: [number, number, number];   // see scripts/camera.ts
}
const DEVICES = {
  // r: tighter than the frame's inner curve, so the screen reaches under its
  // corners (at the frame's own radius the cover showed through a sliver there).
  iphone: { src: 'iphone-frame.webp', w: 978, h: 2000, x0: 52, y0: 50, x1: 926, y1: 1950, r: 130 },
  // An older iPhone with a notch (the notch is part of the image).
  'iphone-notch': { src: 'iphone-notch-frame.webp', w: 1061, h: 2000, x0: 127, y0: 127, x1: 935, y1: 1875, r: 88 },
  // No frame image: the recording has the phone in it already; it's clipped
  // to the phone's own rounded outline.
  'iphone-recorded': { src: '', w: 722, h: 1462, x0: 0, y0: 0, x1: 722, y1: 1462, r: 117 },   // trimmed to the phone's own edge
  ipad: { src: 'ipad-frame.webp', w: 2000, h: 1424, x0: 83, y0: 80, x1: 1917, y1: 1344, r: 50 },
  // No frame: a desktop recording (16:10) shown as a window, its corners and
  // border drawn by smooth-corners.ts.
  desktop: { src: '', w: 1600, h: 1000, x0: 0, y0: 0, x1: 1600, y1: 1000, r: 0 },
  // The same for a 16:9 recording (cropped into 16:10 it lost its sides).
  'desktop-wide': { src: '', w: 1600, h: 900, x0: 0, y0: 0, x1: 1600, y1: 900, r: 0 },
  // And a Mac app window recorded whole, title bar included (about 3:2).
  'desktop-mac': { src: '', w: 1600, h: 1050, x0: 0, y0: 0, x1: 1600, y1: 1050, r: 0 },
  // And an app window trimmed from an edited film (Claude Desktop), in its own proportions.
  'desktop-app': { src: '', w: 1600, h: 1030, x0: 0, y0: 0, x1: 1600, y1: 1030, r: 0 },
  // No frame: filmed footage (16:9), a plain picture with soft round corners.
  film: { src: '', w: 1600, h: 900, x0: 0, y0: 0, x1: 1600, y1: 900, r: 0 },
};
const { webm, mp4, poster, start = 0, camera, device = 'iphone', rest } = Astro.props;
const d = DEVICES[device];
const frame = `${import.meta.env.BASE_URL}images/${d.src}`;
const pct = (v: number, of: number) => `${(v / of * 100).toFixed(4)}%`;
const shape = [
  `--device-ar: ${d.w} / ${d.h}`,
  `--open-left: ${pct(d.x0, d.w)}`, `--open-right: ${pct(d.w - d.x1, d.w)}`,
  `--open-top: ${pct(d.y0, d.h)}`, `--open-bottom: ${pct(d.h - d.y1, d.h)}`,
  `--open-radius: ${pct(d.r, d.x1 - d.x0)} / ${pct(d.r, d.y1 - d.y0)}`,
].join('; ');
// The rest framing (the thumbnail) in the markup too, as camera.ts sets it, so
// a cover shows it from the first paint rather than snapping to it later.
const restStyle = rest ? (() => {
  const [x, y, s] = rest;
  const t = (v: number) => (((0.5 - v) * s + (s - 1) / 2) * 100).toFixed(3);
  return `; scale: ${s}; --cam-s: ${s}; translate: ${t(x)}% ${t(y)}%`;
})() : '';
---
<div class="glass-frame" data-device={device} style={shape + restStyle} data-camera={camera && JSON.stringify(camera)} data-rest={rest && JSON.stringify(rest)}>
  <div class="screen" data-smooth={device === 'desktop' || device === 'desktop-wide' || device === 'desktop-mac' || device === 'desktop-app' || device === 'film' ? 'clip' : undefined} style={`--poster: url("${poster}")`}>
    <!-- Shows its poster (the `start` frame) until the cover is hovered or opened
         (work-strip.ts); preload none, so a dozen idle covers don't each hold a
         video decoder and its frames in GPU memory. -->
    <video poster={poster} muted loop playsinline preload="none" data-start={start}>
      {webm && <source src={webm} type="video/webm" />}
      <source src={mp4} type="video/mp4" />
    </video>
  </div>
  {d.src && <img class="device" src={frame} alt="" width={d.w} height={d.h} draggable="false" />}
  <!-- Desktop: the window's outer border, the same smoothed outer border as the controls. -->
  {(device === 'desktop' || device === 'desktop-wide' || device === 'desktop-mac' || device === 'desktop-app') && <div class="window-edge" data-smooth="surface" aria-hidden="true"></div>}
</div>

<style>
  .glass-frame {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    height: var(--device-height); aspect-ratio: var(--device-ar);
    filter: drop-shadow(var(--device-shadow));
  }
  /* Landscape devices are sized by width instead. */
  .glass-frame[data-device="ipad"], .glass-frame[data-device="desktop"], .glass-frame[data-device="desktop-wide"], .glass-frame[data-device="desktop-mac"], .glass-frame[data-device="desktop-app"], .glass-frame[data-device="film"] { height: auto; width: var(--device-width-landscape); }
  /* Desktop: the recording itself as a window, with smoothed corners, a
     hairline border and the device's soft shadow (on the frame, outside the clip). */
  .glass-frame[data-device="desktop"] .screen, .glass-frame[data-device="desktop-wide"] .screen, .glass-frame[data-device="desktop-mac"] .screen, .glass-frame[data-device="desktop-app"] .screen {
    inset: 0; background: var(--color-cover-bg);
    border-radius: var(--desktop-radius);   /* smoothed by the clip (smooth-corners.ts) */
    --smooth-radius-share: var(--desktop-radius-share);   /* ...which scales it with the window */
  }
  .glass-frame[data-device="desktop-app"] .screen, .glass-frame[data-device="desktop-app"] .window-edge { --smooth-radius-share: var(--desktop-app-radius-share); }
  /* The thumbnail frame under the video too, so if iOS lands the video a hair
     off its box (it snaps it to whole pixels, and the cover's zoom shows it),
     the sliver at the edge is the same picture, not white. */
  .glass-frame[data-device="desktop-app"] .screen { background: var(--poster) 0 0 / 100% 100% no-repeat, var(--color-cover-bg); }
  /* At rest it shows that frame alone, the video hidden (not just transparent)
     until it plays: iOS keeps even a transparent video on its own layer, which
     shaved the window's top under its edge once the thumbnail's zoom enlarged
     it. Hidden, the still is drawn with the page and the edge sits on it.
     Paused by hand in the player (data-held), it stays: that frame is the
     one to show, and scrubbing moves it. */
  .glass-frame[data-device="desktop-app"]:not(.live) video:not([data-held]) { visibility: hidden; }
  /* Safari (html.safari, work-strip.ts) does the same for every device: an
     idle video only shows its poster, which the screen already draws, and
     each one is a layer of its own that it redraws while covers move (into
     the grid, about a third of the frame rate). */
  :global(html.safari) .glass-frame:not(.live) video:not([data-held]) { visibility: hidden; }
  /* iOS draws the window's top a quarter pixel short of its edge, and the
     thumbnail's zoom made that a visible gap. Its top reaches up that much
     there (test page, variant 4, the one that sat tight on an iPhone). */
  :global(html.ios) .glass-frame[data-device="desktop-app"] .screen { top: -0.25px; }
  /* Its shadow all the way round, softer: the usual one falls below the
     window, and the thumbnail crops the window's bottom off, so it didn't show. */
  .glass-frame[data-device="desktop-app"] { filter: drop-shadow(0 2px 14px rgba(0, 0, 0, 0.22)); }
  /* Film: filmed footage, full bleed in its frame, rounder corners, no edge. */
  .glass-frame[data-device="film"] .screen {
    inset: 0; background: var(--color-cover-bg);
    border-radius: var(--film-radius);   /* smoothed by the clip (smooth-corners.ts) */
  }
  /* Their poster under the video too, cropped as the video is (object-fit:
     cover), so Safari can hide an idle video (below) and show the same frame. */
  .glass-frame:is([data-device="desktop"], [data-device="desktop-wide"], [data-device="desktop-mac"], [data-device="film"]) .screen {
    background: var(--poster) center / cover no-repeat, var(--color-cover-bg);
  }
  .window-edge {
    position: absolute; inset: 0; pointer-events: none;
    --surface-bg: transparent; --surface-border: var(--color-desktop-border); --surface-blur: none;
    border: 1px solid var(--surface-border); border-radius: var(--desktop-radius);
    --smooth-radius-share: var(--desktop-radius-share);
  }
  /* A hairline at any camera zoom: thinned by the camera's scale (--cam-s, set
     with it), which would otherwise thicken it with the shot. */
  .window-edge :global(.smooth-border path) { stroke-width: calc(2 * var(--desktop-edge-width) / var(--cam-s, 1)); }
  /* The opening, in shares of the image, grown by --device-bleed under the frame. */
  .screen {
    position: absolute; overflow: hidden; background: #000;
    left: calc(var(--open-left) - var(--device-bleed)); right: calc(var(--open-right) - var(--device-bleed));
    top: calc(var(--open-top) - var(--device-bleed)); bottom: calc(var(--open-bottom) - var(--device-bleed));
    border-radius: var(--open-radius);
    /* The poster behind the video, so a cover coming on screen never shows
       black while its video catches up. */
    background-image: var(--poster); background-size: 100% 100%;
    background-origin: content-box; background-clip: content-box;   /* exactly under the video, not in the iPad's display edge */
  }
  video { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity 0.25s ease-out; }   /* fades to the poster when it stops (work-strip.ts) */
  /* Played full screen (phones, work-strip.ts): the whole recording, letterboxed. */
  video:fullscreen { object-fit: contain; background: #000; border-radius: 0 !important; }
  /* Recordings can be a hair off the iPad's screen shape (1.43 vs 1.45); fit it
     exactly rather than crop, so the status bar doesn't slip under the corner. */
  .glass-frame[data-device="ipad"] video { object-fit: fill; border-radius: var(--open-radius); }
  /* A recording with its own phone in it: the clip is the phone's outline, no bleed. */
  .glass-frame[data-device="iphone-recorded"] .screen { inset: 0; background: var(--poster) center / cover no-repeat; }   /* its poster only (no black), cropped as the video is */
  .device { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; pointer-events: none; user-select: none; }
</style>

<script>
  // Trimmed app windows, and every frame in Safari, show their still at rest
  // (see the styles): the video only while it plays.
  for (const frame of document.querySelectorAll<HTMLElement>('.glass-frame')) {
    const video = frame.querySelector('video');
    if (!video) continue;
    video.addEventListener('play', () => frame.classList.add('live'));   // on the request, so it's never asked to play while hidden
    for (const e of ['pause', 'emptied', 'ended']) video.addEventListener(e, () => frame.classList.remove('live'));
  }
</script>
