---
import { existsSync } from 'node:fs';

// Figma 53:310. The photo is the one asset that can't be pulled from Figma
// automatically: drop it at public/images/khalil.jpg and it shows up here.
const photo = existsSync('public/images/khalil.jpg') ? `${import.meta.env.BASE_URL}images/khalil.jpg` : null;
const home = import.meta.env.BASE_URL;

interface Props {
  // The theme and grid buttons drive the work strip, so they only show with it.
  tools?: boolean;
}
const { tools = true } = Astro.props;
---
<header class="site-header">
  <a class="who" href={home}>
    <span class="photo">
      {photo && <img src={photo} alt="Khalil Cader" width="50" height="56" />}
    </span>
    <span class="name">
      <span>Khalil Cader</span>
      <span class="role">Product Designer</span>
    </span>
  </a>
  {tools && <div class="tools" role="group" aria-label="View">
    <!-- Figma 67:848: one glass container holding both buttons, split by a thin divider. -->
    <button class="tool" id="theme-button" type="button" aria-label="Switch to dark theme" title="Theme (T)">
      <!-- Sun: stand-in drawn to the Figma icon's spec (24px, 1.5 stroke, round
           joins); the Figma SVG couldn't be exported from this environment. -->
      <svg class="icon icon-light" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="3.75" />
        <path d="M12 3.75v1.5M12 18.75v1.5M3.75 12h1.5M18.75 12h1.5M6.17 6.17l1.06 1.06M16.77 16.77l1.06 1.06M6.17 17.83l1.06-1.06M16.77 7.23l1.06-1.06" />
      </svg>
      <!-- The moon isn't in Figma yet. -->
      <svg class="icon icon-dark" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19.25 14.1A7.5 7.5 0 0 1 9.9 4.75a7.5 7.5 0 1 0 9.35 9.35Z" />
      </svg>
    </button>
    <span class="divider" aria-hidden="true"></span>
    <button class="tool" id="grid-button" type="button" aria-pressed="false" aria-label="Show as grid" title="Grid (G)">
      <!-- Figma 55:832: four 7px squares, 1.5px stroke, 2px corners. -->
      <svg class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="4.75" y="4.25" width="5.5" height="5.5" rx="1.25" />
        <rect x="4.75" y="14.25" width="5.5" height="5.5" rx="1.25" />
        <rect x="14.75" y="4.25" width="5.5" height="5.5" rx="1.25" />
        <rect x="14.75" y="14.25" width="5.5" height="5.5" rx="1.25" />
      </svg>
    </button>
  </div>}
</header>

<style>
  .site-header {
    position: fixed; z-index: 30;
    top: calc(env(safe-area-inset-top, 0px) + var(--header-top));
    left: var(--page-pad); right: var(--page-pad);
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-3);
    padding: var(--header-pad);
    pointer-events: none;
  }
  .site-header > * { pointer-events: auto; }

  .who {
    display: flex; align-items: center; gap: var(--space-3);
    min-width: 0; text-decoration: none;
    transition: opacity 0.2s;
  }
  .photo {
    flex: none; width: var(--photo-width); height: var(--photo-height);
    border: 1px solid var(--color-photo-border); border-radius: var(--photo-radius);
    box-shadow: var(--photo-shadow);
    background: var(--color-cover-bg);
    overflow: hidden;
  }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .name {
    display: flex; flex-direction: column;
    font-size: var(--text-name-size); font-weight: var(--text-name-weight);
    letter-spacing: var(--text-name-tracking); line-height: normal;
    white-space: nowrap;
  }
  .role { opacity: var(--text-secondary-opacity); }

  /* Figma 67:848: 81 × 40, 10px corners, glass. Each button is a 36px tile
     inset 2px, so a pressed tile's corners sit concentric with the container. */
  .tools {
    display: flex; align-items: center;
    height: var(--button-size); padding: var(--tools-inset);
    border: var(--button-border-width) solid var(--color-button-border);
    border-radius: var(--button-radius);
    background: var(--color-button-bg);
    -webkit-backdrop-filter: blur(var(--button-blur)); backdrop-filter: blur(var(--button-blur));
    box-shadow: var(--button-shadow);
  }
  :global(html:not(.js)) .tools { display: none; }
  .tool {
    width: var(--tool-width); height: 100%; padding: 0;
    display: inline-flex; align-items: center; justify-content: center;
    border: 0; background: none;
    border-radius: calc(var(--button-radius) - var(--tools-inset) - var(--button-border-width));
    color: var(--color-fg); cursor: pointer;
  }
  .divider {
    flex: none; width: 1px; height: var(--icon-size); margin: 0 var(--tools-divider-gap);
    border-radius: 1px; background: var(--color-divider);
  }
  /* Toggled on: a tinted tile with a filled icon; the divider steps aside. */
  .tool[aria-pressed="true"] { background: var(--color-toggle-on-bg); color: var(--color-toggle-on-fg); }
  .tool[aria-pressed="true"] rect { fill: currentColor; }
  .tools:has(.tool[aria-pressed="true"]) .divider { visibility: hidden; }
  .tool:focus-visible, .who:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .icon { flex: none; width: var(--icon-size); height: var(--icon-size); }

  /* The icon shows the theme in effect: sun in light, moon in dark. */
  .icon-dark { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-scheme="light"])) .icon-light { display: none; }
    :global(:root:not([data-scheme="light"])) .icon-dark { display: block; }
  }
  :global(:root[data-scheme="dark"]) .icon-light { display: none; }
  :global(:root[data-scheme="dark"]) .icon-dark { display: block; }
</style>
