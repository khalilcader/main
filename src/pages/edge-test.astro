---
// Temporary: the Claude Desktop thumbnail drawn several ways, to find which
// keeps the window's edge on the video on iOS. Not linked; delete when done.
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import { getEntry } from 'astro:content';
const entry = await getEntry('work', 'claude-desktop');
const variants = [
  ['A', 'as it is now'],
  ['B', 'no shadow under the window'],
  ['C', 'plain border, not the smoothed one'],
  ['D', 'still image only, video hidden'],
  ['E', 'not zoomed in'],
];
---
<Base title="Edge test">
  <main class="edge-test">
    {variants.map(([v, what]) => (
      <section class={`v-${v}`}>
        <p><b>{v}</b> {what}</p>
        <div class="box" style={`--aspect: ${entry!.data.cover.aspect}`}><Cover cover={entry!.data.cover} /></div>
      </section>
    ))}
  </main>
  <script is:inline>
    // C: the window's edge as a plain CSS border (before smooth-corners runs).
    document.querySelectorAll('.v-C .window-edge').forEach((e) => e.removeAttribute('data-smooth'));
  </script>
</Base>

<style is:global>
  .edge-test { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 12px; padding: 24px 12px; font: 15px/1.3 system-ui, sans-serif; }
  .edge-test p { margin: 0 0 6px; }
  .edge-test b { font-size: 22px; margin-right: 4px; }
  .edge-test .box {
    position: relative; width: 100%; aspect-ratio: var(--aspect); container-type: inline-size;
    border-radius: calc(0.11 * 100cqw); overflow: hidden;
    --desktop-radius: 1.5cqw; --desktop-radius-share: 0.015;
  }
  .v-B .glass-frame { filter: none !important; }
  .v-C .window-edge { border-width: calc(1px / var(--cam-s, 1)) !important; border-radius: 2% / 3.107% !important; }
  .v-D video { visibility: hidden !important; }
  .v-E .glass-frame { scale: 1 !important; translate: none !important; }
</style>
