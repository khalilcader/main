---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---
<Base title={`${item.data.title} — Khalil Cader`} description={item.data.summary}>
  <SiteHeader tools={false} />
  <!-- Case study layout isn't designed yet; this is a plain reading column. -->
  <main class="case">
    <h1>{item.data.title}</h1>
    <p>{item.data.role} · {item.data.year}</p>
    <Content />
  </main>
</Base>

<style>
  .case {
    max-width: 720px; margin: 0 auto;
    padding: calc(var(--header-top) + var(--header-pad) * 2 + var(--photo-height) + var(--space-5)) var(--gutter) var(--space-6);
  }
</style>
